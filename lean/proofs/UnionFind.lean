import Mathlib

namespace VerifiedAlgorithms

/-- Quick-find union: every element whose label equals `a`'s label takes `b`'s label. -/
def ufUnion {n : ℕ} (lbl : Fin n → Fin n) (a b : Fin n) : Fin n → Fin n :=
  fun x => if lbl x = lbl a then lbl b else lbl x

/-- Process a list of union operations, starting from singletons. -/
def ufBuild {n : ℕ} (pairs : List (Fin n × Fin n)) : Fin n → Fin n :=
  pairs.foldl (fun lbl p => ufUnion lbl p.1 p.2) id

theorem uf_union_eq {n : ℕ} (lbl : Fin n → Fin n) (a b x y : Fin n) (h : lbl x = lbl y) :
    ufUnion lbl a b x = ufUnion lbl a b y := by
  simp only [ufUnion, h]

theorem uf_fold {n : ℕ} : ∀ (l pre : List (Fin n × Fin n)) (lbl : Fin n → Fin n),
    (∀ x, Relation.EqvGen (fun a b => (a, b) ∈ pre) x (lbl x)) →
    (∀ x y, Relation.EqvGen (fun a b => (a, b) ∈ pre) x y → lbl x = lbl y) →
    (∀ x, Relation.EqvGen (fun a b => (a, b) ∈ pre ++ l) x
        (l.foldl (fun lbl p => ufUnion lbl p.1 p.2) lbl x)) ∧
    (∀ x y, Relation.EqvGen (fun a b => (a, b) ∈ pre ++ l) x y →
      l.foldl (fun lbl p => ufUnion lbl p.1 p.2) lbl x =
        l.foldl (fun lbl p => ufUnion lbl p.1 p.2) lbl y) := by
  intro l
  induction l with
  | nil =>
    intro pre lbl hP hQ
    simp only [List.append_nil, List.foldl_nil]
    exact ⟨hP, hQ⟩
  | cons p l ih =>
    intro pre lbl hP hQ
    obtain ⟨a, b⟩ := p
    have hsub : ∀ x y, (x, y) ∈ pre → (x, y) ∈ pre ++ [(a, b)] := by
      intro x y h
      exact List.mem_append_left _ h
    have hab : ((a, b) : Fin n × Fin n) ∈ pre ++ [(a, b)] := by simp
    have hP' : ∀ x, Relation.EqvGen (fun u v => (u, v) ∈ pre ++ [(a, b)]) x
        (ufUnion lbl a b x) := by
      intro x
      have mono : ∀ u v, Relation.EqvGen (fun a b => (a, b) ∈ pre) u v →
          Relation.EqvGen (fun u v => (u, v) ∈ pre ++ [(a, b)]) u v := by
        intro u v h
        induction h with
        | rel x y h => exact Relation.EqvGen.rel _ _ (hsub x y h)
        | refl x => exact Relation.EqvGen.refl _
        | symm x y _ ih => exact Relation.EqvGen.symm _ _ ih
        | trans x y z _ _ ih1 ih2 => exact Relation.EqvGen.trans _ _ _ ih1 ih2
      by_cases hx : lbl x = lbl a
      · simp only [ufUnion, hx, if_true]
        have h1 := mono _ _ (hP x)
        rw [hx] at h1
        have h2 := Relation.EqvGen.symm _ _ (mono _ _ (hP a))
        have h3 : Relation.EqvGen (fun u v => (u, v) ∈ pre ++ [(a, b)]) a b :=
          Relation.EqvGen.rel _ _ hab
        have h4 := mono _ _ (hP b)
        exact Relation.EqvGen.trans _ _ _ h1
          (Relation.EqvGen.trans _ _ _ h2 (Relation.EqvGen.trans _ _ _ h3 h4))
      · simp only [ufUnion, hx, if_false]
        exact mono _ _ (hP x)
    have hQ' : ∀ x y, Relation.EqvGen (fun u v => (u, v) ∈ pre ++ [(a, b)]) x y →
        ufUnion lbl a b x = ufUnion lbl a b y := by
      intro x y h
      induction h with
      | rel x y h =>
        rcases List.mem_append.mp h with h | h
        · exact uf_union_eq lbl a b x y (hQ x y (Relation.EqvGen.rel _ _ h))
        · simp only [List.mem_singleton, Prod.mk.injEq] at h
          obtain ⟨rfl, rfl⟩ := h
          simp only [ufUnion]
          split_ifs <;> simp_all
      | refl x => rfl
      | symm x y _ ih => exact ih.symm
      | trans x y z _ _ ih1 ih2 => exact ih1.trans ih2
    obtain ⟨h1, h2⟩ := ih (pre ++ [(a, b)]) (ufUnion lbl a b) hP' hQ'
    have e : pre ++ [(a, b)] ++ l = pre ++ (a, b) :: l := by simp
    rw [e] at h1 h2
    simp only [List.foldl_cons]
    exact ⟨h1, h2⟩

/-- Union-find is correct: two elements end with the same label exactly when they are
connected by the unions (the equivalence relation generated by the pairs). -/
theorem ufBuild_correct {n : ℕ} (pairs : List (Fin n × Fin n)) (x y : Fin n) :
    ufBuild pairs x = ufBuild pairs y ↔ Relation.EqvGen (fun a b => (a, b) ∈ pairs) x y := by
  have hQ0 : ∀ x y, Relation.EqvGen (fun a b => (a, b) ∈ ([] : List (Fin n × Fin n))) x y →
      (id x : Fin n) = id y := by
    intro x y h
    induction h with
    | rel x y h => simp at h
    | refl x => rfl
    | symm x y _ ih => exact ih.symm
    | trans x y z _ _ ih1 ih2 => exact ih1.trans ih2
  obtain ⟨hP, hQ⟩ := uf_fold pairs [] id (fun x => Relation.EqvGen.refl x) hQ0
  simp only [List.nil_append] at hP hQ
  constructor
  · intro h
    have hy := Relation.EqvGen.symm _ _ (hP y)
    have hx := hP x
    unfold ufBuild at h
    rw [h] at hx
    exact Relation.EqvGen.trans _ _ _ hx hy
  · intro h
    exact hQ x y h

end VerifiedAlgorithms
