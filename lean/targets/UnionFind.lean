import Mathlib

namespace VerifiedAlgorithms

/-- Quick-find union: every element whose label equals `a`'s label takes `b`'s label. -/
def ufUnion {n : ℕ} (lbl : Fin n → Fin n) (a b : Fin n) : Fin n → Fin n :=
  fun x => if lbl x = lbl a then lbl b else lbl x

/-- Process a list of union operations, starting from singletons. -/
def ufBuild {n : ℕ} (pairs : List (Fin n × Fin n)) : Fin n → Fin n :=
  pairs.foldl (fun lbl p => ufUnion lbl p.1 p.2) id

/-- Union-find is correct: two elements end with the same label exactly when they are
connected by the unions (the equivalence relation generated by the pairs). -/
theorem ufBuild_correct {n : ℕ} (pairs : List (Fin n × Fin n)) (x y : Fin n) :
    ufBuild pairs x = ufBuild pairs y ↔ Relation.EqvGen (fun a b => (a, b) ∈ pairs) x y := by
  sorry

end VerifiedAlgorithms
